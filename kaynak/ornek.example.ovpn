# Örnek OpenVPN istemci yapılandırması.
# Kendi sunucunun verdiği .ovpn dosyasını kullan:
#   masaüstü istemci -> kaynak/my.ovpn
#   Android istemci  -> kaynak/mobile.ovpn  (derlemede APK'ye assets/vpn.ovpn olarak konur)
# Gerçek .ovpn dosyaları .gitignore'da; anahtarları bu örneğe YAZMA.
client
dev tun
proto udp
remote <SUNUCU_IP> 443
resolv-retry infinite
nobind
persist-key
persist-tun
remote-cert-tls server
auth SHA512
ignore-unknown-option block-outside-dns
verb 3
<cert>
-----BEGIN CERTIFICATE-----
(istemci sertifikası)
-----END CERTIFICATE-----
</cert>
<key>
(istemci özel anahtarı)
</key>
<ca>
-----BEGIN CERTIFICATE-----
(sunucu CA sertifikası)
-----END CERTIFICATE-----
</ca>
<tls-crypt>
(tls-crypt anahtarı)
</tls-crypt>
